{{Weapon/LayoutV2

<!-- Type of weapon ; accepted values: sword, sura-sword, 2handed, dagger, bow, bell, fan, claw -->
|Type = claw

<!-- Level of weapon - accepted values: Level or level interval in ## - ## format -->
|Level = 120

<!-- Classes that can use this weapon accepted values are warrior ; ninja ; shaman ; sura ; lycan ; 3 (for warrior ninja and sura) ; leave blank for all classes-->
|wearable = lycan

<!-- number of sockets for spirit stones - numeric value only -->
|Sockets = 3

<!-- Powershard used to add 6/7 bonus -->
|Powershard = {{Ti|Holy Powershard (120)}}

<!-- Origin of weapon (remove whatever is not used) -->
|Origin =
<ul>
*'''[[NPC]]:''' {{Tm|Serpent Statue}} (Crafted):
:*{{Ti|Serpent Claw (craft)}}
:*{{Ti|Serpent Design}} 10x
:*{{Ti|Northwind Anvil}} 5x
:*{{Ti|Dark Jadite}} 10x
:*{{Ti|Northwind Whetstone}} 5x
:*{{Ti|Gaya|100 Gaya}}
:*{{Ti|Yang|10.000.000 Yang}}
*'''[[Boxes]]:''' {{Ti|Wh. Dragon Chest (Heavy)}}
</ul>


<!-- Other information -->
|Other = The crafting method has a 50% success. See also: [[Item Refinement]]
<br>
*Up to 3 default bonuses are added, marked with a <span style="color:#3400FF">blue color</span>
*All default bonuses and values are randomized chosen by system
*Below you'll find a table with all possible bonuses as well as the min-max values
*When changing the 1-5 bonuses, it is possible to have the same bonus as default

<!-- Maximum upgrade level (only required beyond +9) -->
