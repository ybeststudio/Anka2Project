{{Armour/LayoutV2

<!-- Classes that can use this armour, accepted values are warrior ; ninja ; shaman ; sura ; lycan -->
|Classes = ninja

<!-- Level of armour - accepted values: Level or level interval in ## - ## format -->
<!-- Level 50 is pre-set for King/Queen armours -->
|Level = 120

<!-- Number of sockets for spirit stones - numeric value only -->
|Sockets = 3

<!-- Powershard used to add 6/7 bonus -->
|Powershard = {{Ti|Holy Powershard (120)}}

<!-- Origin of armour -->
|Origin=
<ul>
*'''[[NPC]]:''' {{Tm|Serpent Statue}} (Crafted):
:*{{Ti|Serpent Waistcoat (craft)}}
:*{{Ti|Serpent Design}} 10x
:*{{Ti|Serpent Silk}} 5x
:*{{Ti|Dark Jadite}} 10x
:*{{Ti|Serpent Polish}} 5x
:*{{Ti|Gaya|100 Gaya}}
:*{{Ti|Yang|10.000.000 Yang}}
</ul>


<!-- Other information -->
|Other = The crafting method has a 50% success. See also: [[Item Refinement]]
<br>
*Up to 3 default bonuses are added, marked with a <span style="color:#3400FF">blue color</span>
*All default bonuses and values are randomized chosen by system
*Below you'll find a table with all possible bonuses as well as the min-max values
*When changing the 1-5 bonuses, it is possible to have the same bonus as default


